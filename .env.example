# Copy to .env (root) and apps/web/.env.local is not needed: the web app reads ../../.env too.
# Never commit real values.

DATABASE_URL="postgresql://bt:bt@localhost:5432/bt_commerce"
# Used for schema changes and seeding. Locally the same as DATABASE_URL.
# Supabase: DATABASE_URL = transaction pooler (port 6543, add ?pgbouncer=true&connection_limit=1),
#           DIRECT_URL   = session pooler (port 5432). Copy both from Supabase › Connect.
#           Special characters in the password must be URL-encoded (@ → %40).
DIRECT_URL="postgresql://bt:bt@localhost:5432/bt_commerce"

# 32 bytes, hex or base64. Generate: openssl rand -hex 32
ENCRYPTION_KEY=""
# Signs session/CSRF cookies. Generate: openssl rand -base64 48
SESSION_SECRET=""

# Public base URL used in OG tags, share links and contract PDFs.
APP_URL="http://localhost:3000"

# Seeded staff password (all demo staff). Change after first login.
SEED_STAFF_PASSWORD="ChangeMe-2026!"

# Integrations — "mock" until real credentials are provided (CLAUDE.md rule 5).
AZANIA_ADAPTER="mock"            # mock | live
AZANIA_API_URL=""
AZANIA_CLIENT_ID=""
AZANIA_CLIENT_SECRET=""
AZANIA_SSO_SECRET="dev-mini-app-sso-secret"   # HMAC secret for mini app SSO tokens (mock)

SMS_ADAPTER="mock"               # mock | live
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="MRUK"

WHATSAPP_ADAPTER="mock"          # mock | live
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

STORAGE_ADAPTER="local"          # local | supabase | s3
STORAGE_BUCKET="bt-files"        # bucket name (created automatically, private)
SUPABASE_URL=""                  # e.g. https://<project>.supabase.co
SUPABASE_SECRET_KEY=""           # server only — never expose to the browser
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

AI_ADAPTER="mock"                # mock | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Vercel/CI: create tables, lock the Supabase data API and load demo data (only if empty) during the build.
DB_SETUP_ON_BUILD="false"

# Show OTP codes on screen in development (never in production).
DEV_SHOW_OTP="true"

# UAT/staging only: enable the mock-SSO demo sign-in in the mini app on production builds (mock adapters only).
DEMO_MODE="false"
