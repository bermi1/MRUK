{
  "name": "@bt/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "dotenv -e ../../.env -- prisma db push --skip-generate",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "reset": "dotenv -e ../../.env -- prisma db push --force-reset --skip-generate && dotenv -e ../../.env -- tsx src/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "deploy": "tsx src/deploy.ts",
    "secure": "DB_SETUP_ON_BUILD=true dotenv -e ../../.env -- tsx src/deploy.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@bt/core": "workspace:*",
    "@types/node": "22.20.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "dotenv-cli": "11.0.0"
  }
}
